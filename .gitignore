# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# One directory per corpus under cache/, holding everything that corpus's runs produce --
# including the answer. Nothing is written outside it, so there is no shared path for one
# corpus's leftovers to be mistaken for another's. The reviewable record is kept: facts,
# derivations, the answer, the extraction log, both provenance reports. The machinery is not.
cache/*/extraction/
cache/*/text/
cache/*/images/
cache/*/stem_categories.json
cache/*.txt
cache/*/*.txt

# No answer at the repository root: every run writes into its corpus's directory.
/submission.json

# Corpora issued by the organisers are theirs to distribute; so is anything derived from them.
cache/agentic-bank-hidden/
cache/agentic-bank-private/
cache/agentic-bank-final/

.DS_Store
.idea/

# Secrets
.env

# Convenience copies of corpus samples; the originals are in agentic-bank-public/
examples/

# Held-out corpora issued by the organisers. agentic-bank-public/ is committed because the
# challenge published it; anything else is theirs to distribute, not ours. The derived files
# are already covered by cache/*/ above.
agentic-bank-private/
agentic-bank-hidden/
agentic-bank-final/
