# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Derived caches (regenerated by the pipeline). cache/facts*.json is kept: it is the
# reviewable record of what was extracted from the documents. Every subdirectory is derived:
# text/, images/ and extraction/ for the published corpus, and one directory per further
# corpus, holding that corpus's own caches, facts and answer.
cache/*/
cache/*.txt
# The published corpus's own answer. The submitted one is submission.json at the root, written
# only by an explicit --out, and that one is tracked.
cache/submission.json

.DS_Store
.idea/

# Secrets
.env

# Convenience copies of corpus samples; the originals are in agentic-bank-public/
examples/

# Held-out corpora issued by the organisers. agentic-bank-public/ is committed because the
# challenge published it; anything else is theirs to distribute, not ours. The derived files
# are already covered by cache/*/ above.
agentic-bank-private/
agentic-bank-hidden/
agentic-bank-final/
